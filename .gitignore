node_modules/
dist/
# Every dotenv variant is ignored — .env and .env.local alone left .env.production,
# .env.staging etc. tracked by default, which is how a real credential reaches git.
# .env.example is the one deliberate exception: placeholders only, no live values.
# Deliberately narrow: this covers dotenv files ONLY. Operational docs, runbooks
# and deploy logs stay tracked — hiding those would trade one blind spot for
# another. test_no_committed_secrets.ts is what guards their CONTENT.
.env*
!.env.example
*.log
.DS_Store
/prisma/migrations/dev.db*
prisma_client_stub.d.ts
debug.ts
emit_dto.ts
dtos.json
dtos_min.json

# Local-only helper scripts (contain user/repo identifiers or token-format outputs)
push.sh
scripts/diag2.ts

# Playwright
test-results/
playwright-report/
.eny

# hub/dist IS committed: dist/qareeb.web.html is the deploy payload that
# Netlify fetches server-side from raw.githubusercontent.com.
# Line 2's blanket `dist/` matches it, and git will not un-ignore a file
# inside an ignored directory — so the directory must be un-ignored first.
!hub/dist/
!hub/dist/*.html

# netlify CLI link state (contains a site id, not a secret — still local-only)
hub/.netlify/

# Visual review — index.html and screenshots are the deliverable; the
# intermediate render output is not.
review/screens/

# Type-check output for the review tooling. `tools/` is compiled so its five
# .tsx files are checked like everything else; nothing consumes the emit —
# vite-node runs the sources directly.
platform/dist-tools/

# Build output — Netlify builds this itself; committing it makes the repo
# disagree with the deploy.
platform/dist-web/
.mobile-pages/

# Throwaway diagnostic probes. Written to the repo root so `playwright`
# resolves, deleted after use. Never part of the product.
probe*.mjs
probe-*.mjs

# desktop audit artefacts
.desktop-shots/
.desktop-findings.json
