# Deploy environment: development | staging | production
DAWAI_ENV=development
NODE_ENV=development

# Required in staging/production (fail-closed)
DATABASE_URL=postgres://dawai:change-me@postgres:5432/dawai
SESSION_PEPPER=replace-with-at-least-32-random-bytes
STORAGE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
WEB_ORIGIN=https://dawai.example
PUBLIC_APP_URL=https://dawai.example

# One-time admin bootstrap. Remove after the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Optional runtime
PORT=8787
STORAGE_PATH=/var/lib/dawai/storage
STORAGE_BACKEND=local
DB_POOL_MAX=20
TRUST_PROXY=true
RUN_LIFECYCLE_IN_API=false
SECURE_COOKIES=true
MVP_DELIVERY_ENABLED=false

# Matching weights (optional overrides)
# MATCH_WEIGHT_DISTANCE=0.28
# MATCH_WEIGHT_RECENT_AVAILABILITY=0.22
# MATCH_WEIGHT_RESPONSE=0.17
# MATCH_WEIGHT_FULFILLMENT=0.13
# MATCH_WEIGHT_OPEN_WINDOW=0.10
# MATCH_WEIGHT_SERVICE=0.06
# MATCH_WEIGHT_WORKLOAD=0.04

REQUEST_LIFETIME_MINUTES=20
OFFER_LIFETIME_MINUTES=10
RESERVATION_ACK_MINUTES=3
RESERVATION_HOLD_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Object storage (required when STORAGE_BACKEND=s3)
# S3_ENDPOINT=https://s3.example
# S3_REGION=auto
# S3_BUCKET=dawai-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Optional malware scanner integration point
# MALWARE_SCAN_URL=

# Push / SMS providers (adapters skip until set)
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=
# SMS_PROVIDER=none
# SMS_API_KEY=
# SMS_SENDER_ID=
