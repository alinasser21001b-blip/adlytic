# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Local development talks to the REAL provider and REAL Turnstile siteverify;
# Cloudflare's documented always-pass test keys are fine locally, never in production.
ENVIRONMENT="development"
ANTHROPIC_API_KEY="replace-with-your-own-key"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
IP_HASH_SECRET="replace-with-a-long-random-string"
