{
  "name": "adlytic-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "test": "vitest run --reporter=verbose",
    "test:browser": "tsx tests/browser/run.ts",
    "cf:types": "wrangler types --env-interface Env worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply adlytic-check-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply adlytic-check-db --remote",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "npm run build && wrangler d1 migrations apply adlytic-check-db --remote && wrangler deploy --var BUILD_ID:$(git rev-parse --short HEAD)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
