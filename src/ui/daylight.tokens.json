{
  "$meta": {
    "name": "Adlytic Daylight",
    "version": "1.0.0-draft",
    "date": "2026-08-09",
    "theme": "light",
    "direction": "rtl-first",
    "status": "proposal — pending sign-off on Q1 (single vs dual theme)"
  },
  "color": {
    "ground": {
      "value": "#F2F7F4",
      "use": "page background, every screen"
    },
    "surface": {
      "value": "#FFFFFF",
      "use": "content blocks, cards, tables"
    },
    "raised": {
      "value": "#E8F0EA",
      "use": "tinted wells, inline callouts, selected nav"
    },
    "hover": {
      "value": "#E8F0EA",
      "use": "hover fill on quiet controls"
    },
    "border": {
      "value": "#D8E4DC",
      "use": "all 1px hairlines",
      "contrastOnGround": "1.4:1 (non-text)"
    },
    "borderStrong": {
      "value": "#C7D8CE",
      "use": "outer frames, device bezels"
    },
    "text": {
      "value": "#0B1F19",
      "contrastOnGround": "15.8:1"
    },
    "textMuted": {
      "value": "#4A5F57",
      "contrastOnGround": "6.4:1"
    },
    "textFaint": {
      "value": "#5F7268",
      "contrastOnGround": "4.8:1",
      "note": "CORRECTED — replaces #7C8F87 for all text"
    },
    "nonTextGrey": {
      "value": "#7C8F87",
      "contrastOnGround": "3.2:1",
      "use": "NON-TEXT ONLY: hatching, gridlines, icon strokes ≥2px. Never on type."
    }
  },
  "accent": {
    "brand": {
      "value": "#0E4034",
      "contrastOnGround": "9.9:1",
      "use": "top bar, primary buttons, active tab, focus ring"
    },
    "brandHover": {
      "value": "#0B1F19"
    },
    "brandActive": {
      "value": "#082A22"
    },
    "signal": {
      "value": "#C8F26B",
      "use": "ONE per screen, ONLY on brand-dark ground. Never on light.",
      "contrastOnBrand": "9.1:1"
    }
  },
  "semantic": {
    "good": {
      "text": "#17714F",
      "fill": "#1D8A63",
      "contrastOnGround": "5.6:1 (text) / 4.0:1 (fill, non-text only)"
    },
    "attention": {
      "text": "#B4552F",
      "fill": "#B4552F",
      "contrastOnGround": "4.5:1"
    },
    "bad": {
      "text": "#A32B1E",
      "fill": "#A32B1E",
      "contrastOnGround": "6.7:1"
    },
    "critical": {
      "text": "#A32B1E",
      "fill": "#A32B1E",
      "spine": "3px inline-start",
      "note": "bad and critical share hue; critical adds the 3px spine + 'قرار اليوم' label"
    },
    "info": {
      "text": "#3E6C8A",
      "fill": "#3E6C8A",
      "contrastOnGround": "5.2:1",
      "use": "INSUFFICIENT_DATA / still collecting. Deliberately blue — must never read as warning."
    }
  },
  "dataviz": {
    "$rule": "Series colours identify WHICH campaign. They never encode health. No series colour may equal a semantic colour.",
    "series1": "#0E4034",
    "series2": "#4A6FA5",
    "series3": "#7B4B7E",
    "series4": "#B8873B",
    "series5": "#5F8A7D",
    "series6": "#8C6A5D",
    "gridline": "#D8E4DC",
    "axis": "#0B1F19",
    "benchmarkTick": {
      "value": "#0B1F19",
      "width": "2px",
      "note": "the black tick is always the benchmark, in every chart type"
    },
    "hatch": {
      "value": "repeating-linear-gradient(135deg,#F2F7F4 0 7px,#E8F0EA 7px 14px)",
      "use": "INSUFFICIENT_DATA fill only"
    }
  },
  "type": {
    "$floor": "12px — no tier below it exists. Arabic diacritics and Eastern digits are unreadable smaller.",
    "display": {
      "family": "IBM Plex Sans Arabic",
      "size": 46,
      "weight": 700,
      "lineHeight": 1.25,
      "tracking": "-0.03em"
    },
    "h1": {
      "family": "IBM Plex Sans Arabic",
      "size": 36,
      "weight": 700,
      "lineHeight": 1.3,
      "tracking": "-0.03em"
    },
    "h2": {
      "family": "IBM Plex Sans Arabic",
      "size": 28,
      "weight": 600,
      "lineHeight": 1.4,
      "tracking": "-0.02em"
    },
    "h3": {
      "family": "IBM Plex Sans Arabic",
      "size": 22,
      "weight": 600,
      "lineHeight": 1.5,
      "tracking": "-0.02em"
    },
    "h4": {
      "family": "IBM Plex Sans Arabic",
      "size": 18,
      "weight": 600,
      "lineHeight": 1.55,
      "tracking": "-0.01em"
    },
    "bodyLarge": {
      "family": "Readex Pro",
      "size": 16,
      "weight": 300,
      "lineHeight": 1.85
    },
    "body": {
      "family": "Readex Pro",
      "size": 14,
      "weight": 400,
      "lineHeight": 1.8
    },
    "bodySmall": {
      "family": "Readex Pro",
      "size": 13,
      "weight": 400,
      "lineHeight": 1.75
    },
    "caption": {
      "family": "Readex Pro",
      "size": 12,
      "weight": 400,
      "lineHeight": 1.7
    },
    "metric": {
      "family": "IBM Plex Sans Arabic",
      "size": 30,
      "weight": 600,
      "numeric": "tabular-nums",
      "tracking": "-0.03em"
    },
    "metricSm": {
      "family": "IBM Plex Sans Arabic",
      "size": 20,
      "weight": 600,
      "numeric": "tabular-nums"
    },
    "input": {
      "size": 16,
      "note": "MINIMUM 16px — below this iOS zooms on focus"
    },
    "$fonts": {
      "display": {
        "family": "IBM Plex Sans Arabic",
        "carriesLatin": true,
        "latinCompanion": "IBM Plex Sans (metrically matched)"
      },
      "text": {
        "family": "Readex Pro",
        "carriesLatin": true,
        "note": "single face covers Arabic + Latin; 'USD 187.50 المبلغ المنفق' does not switch typeface mid-line"
      }
    }
  },
  "spacing": {
    "$scale": [
      4,
      8,
      12,
      20,
      32,
      52
    ],
    "$rule": "one scale, no exceptions"
  },
  "radius": {
    "block": 0,
    "unit": 12,
    "pill": 999,
    "$rule": "0 for blocks/tables, 12 for standalone units, 999 for anything tappable"
  },
  "elevation": {
    "$rule": "NO shadows. The old 1px white inset highlight does not work on a light ground — elevation is expressed by surface tint + 1px border instead.",
    "flat": {
      "background": "#FFFFFF",
      "border": "1px solid #D8E4DC"
    },
    "well": {
      "background": "#E8F0EA",
      "border": "none"
    },
    "inverse": {
      "background": "#0E4034",
      "border": "none"
    }
  },
  "motion": {
    "touch": {
      "duration": 120,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "panel": {
      "duration": 200,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "value": {
      "duration": 420,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "$reducedMotion": "prefers-reduced-motion: all durations → 0ms, state change is instant"
  },
  "a11y": {
    "focusRing": {
      "color": "#0E4034",
      "width": "2px",
      "offset": "2px",
      "contrastOnGround": "9.9:1",
      "passes3to1": true
    },
    "touchTarget": {
      "min": 44,
      "unit": "px"
    },
    "inputFontMin": {
      "value": 16,
      "unit": "px"
    },
    "colorNeverAlone": "every state carries text + shape (spine, hatch, tick) in addition to colour"
  }
}